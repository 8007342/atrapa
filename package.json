{
  "name": "atrapa-web",
  "private": true,
  "scripts": {
    "build": "flutter build web --release --no-web-resources-cdn",
    "dev": "npm run build:dev && wrangler dev --ip 0.0.0.0",
    "preview": "wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "build:dev": "flutter build web --release --no-web-resources-cdn --dart-define=ATRAPA_DEV_PLAY=true"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
